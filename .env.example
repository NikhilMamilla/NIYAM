# Hosted model: anthropic | openai_compat
HOSTED_LLM_PROVIDER=
HOSTED_LLM_MODEL=
HOSTED_LLM_API_KEY=
# only for HOSTED_LLM_PROVIDER=openai_compat, e.g. https://api.openai.com/v1
HOSTED_LLM_BASE_URL=

# Open model behind an OpenAI-compatible endpoint (Ollama, vLLM, LM Studio), e.g. http://localhost:11434/v1
OPEN_MODEL_ENDPOINT=
OPEN_MODEL_NAME=

LLM_MAX_RETRIES=3
LLM_TIMEOUT_S=120
