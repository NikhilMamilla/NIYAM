# Hosted model: anthropic | openai_compat
HOSTED_LLM_PROVIDER=
HOSTED_LLM_MODEL=
HOSTED_LLM_API_KEY=
# only for HOSTED_LLM_PROVIDER=openai_compat, e.g. https://api.openai.com/v1
HOSTED_LLM_BASE_URL=

# Open model behind an OpenAI-compatible endpoint (Ollama, vLLM, LM Studio), e.g. http://localhost:11434/v1
OPEN_MODEL_ENDPOINT=
OPEN_MODEL_NAME=
# Bearer token for hosted OpenAI-compatible endpoints (e.g. NVIDIA); leave empty for keyless local servers (Ollama)
OPEN_MODEL_API_KEY=

# Optional JSON merged into every request body, e.g. to turn off hidden reasoning that spends the token budget:
# HOSTED_LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}      (Z.ai GLM)
# OPEN_MODEL_EXTRA_BODY={"reasoning_effort": "none"}            (NVIDIA Nemotron)
HOSTED_LLM_EXTRA_BODY={}
OPEN_MODEL_EXTRA_BODY={}
# Free-tier limits: minimum seconds between the starts of two calls, per slot
HOSTED_LLM_MIN_INTERVAL_S=0
OPEN_MODEL_MIN_INTERVAL_S=1.6

LLM_MAX_RETRIES=3
# HTTP 429 only (waits Retry-After, else exponential backoff capped at 60 s)
LLM_RATE_LIMIT_RETRIES=8
LLM_TIMEOUT_S=120
