<?xml version="1.0" encoding="utf-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <info>
    <title>EXAMPLE 1 (synthetic): guard rail height</title>
  </info>
  <specifications>
    <specification name="EXAMPLE-1 guard rails" ifcVersion="IFC4" identifier="EXAMPLE-1"
        description="Guard rails shall be not less than 1.1 m in height."
        instructions="Synthetic example rule, not from any bye-law.">
      <applicability minOccurs="0" maxOccurs="unbounded">
        <entity>
          <name><simpleValue>IFCRAILING</simpleValue></name>
          <predefinedType><simpleValue>GUARDRAIL</simpleValue></predefinedType>
        </entity>
      </applicability>
      <requirements>
        <property dataType="IFCPOSITIVELENGTHMEASURE" cardinality="required">
          <propertySet><simpleValue>Pset_RailingCommon</simpleValue></propertySet>
          <baseName><simpleValue>Height</simpleValue></baseName>
          <value>
            <xs:restriction base="xs:double">
              <xs:minInclusive value="1.1"/>
            </xs:restriction>
          </value>
        </property>
      </requirements>
    </specification>
  </specifications>
</ids>
