{
  "name": "niyam-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "docs:pdf": "node scripts/build-pdfs.mjs",
    "predev": "node scripts/sync-downloads.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-downloads.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "postinstall": "node scripts/copy-wasm.mjs",
    "site-data": "node --experimental-strip-types --no-warnings scripts/build-site-data.ts"
  },
  "dependencies": {
    "@thatopen/components": "3.6.0",
    "@thatopen/fragments": "3.6.0",
    "camera-controls": "3.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "web-ifc": "0.0.77"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "marked": "^15.0.12",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
